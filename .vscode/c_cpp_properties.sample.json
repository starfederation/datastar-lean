// Copy to c_cpp_properties.json (gitignored) and set the toolchain include
// path to match lean-toolchain; `lean --print-prefix` prints the prefix.
{
  "version": 4,
  "configurations": [
    {
      "name": "datastar-brotli",
      "includePath": [
        "${env:HOME}/.elan/toolchains/leanprover--lean4---v4.34.1/include",
        "${workspaceFolder}/datastar-brotli/vendor/brotli/brotli-1.2.0/c/include"
      ],
      "defines": ["NDEBUG", "DATASTAR_BROTLI_TESTING"],
      "cStandard": "c11"
    }
  ]
}
